# ==========================================================================
# 金枢 FinTrust Agent - 后端环境变量样例
# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，严禁提交真实密钥。
# ==========================================================================

# ---------- 运行环境 ----------
APP_ENV=development
APP_NAME=金枢 FinTrust Agent
API_PREFIX=/api/v1
# 允许的前端来源（逗号分隔），用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# SQLite 数据库文件路径（相对于 backend/ 目录）
DATABASE_URL=sqlite:///./data/fintrust.db

# ---------- LLM（OpenAI 兼容接口） ----------
# 未配置 API Key 时后端自动进入「本地演示模式」，
# 意图识别与参数抽取由本地规则引擎完成，返回体中 demo_mode=true 明确标注。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ---------- 安全策略阈值（单位：元） ----------
# 赛事口径：黄色 = 写操作且执行后日累计 ≤ 此值；红色 = 执行后日累计 > 此值。
# 日累计为唯一主判定轴；单笔金额仅作辅助升红因子。
POLICY_YELLOW_DAILY_MAX=1000
POLICY_RED_DAILY_MIN=1000
# 单笔辅助升红阈值（不替代日累计判断）
POLICY_RED_SINGLE_MIN=10000
# 风控硬红线（超出直接阻断）
POLICY_RED_DAILY_TOTAL=100000
# 触发熔断的连续失败次数
CIRCUIT_BREAKER_THRESHOLD=5
# 熔断恢复等待时间（秒）
CIRCUIT_BREAKER_RESET=60

# ---------- 业务时区 ----------
# 日累计以「交易发生日」为准
BUSINESS_TIMEZONE=Asia/Shanghai

# ---------- 认证 / 会话 / MFA ----------
# 会话有效期（分钟）
SESSION_TTL_MINUTES=720
# 转账工单默认过期时间（分钟）
TRANSFER_ORDER_TTL_MINUTES=15
# MFA 挑战默认有效期（秒）
MFA_TTL_SECONDS=300
# MFA 最大错误尝试次数
MFA_MAX_ATTEMPTS=5
# MFA 验证码 HMAC 服务端密钥（生产环境必须设置为随机值）
MFA_SECRET_KEY=
# 会话 token 哈希盐（生产环境必须设置为随机值）
AUTH_SESSION_SECRET=
# 演示账号密码（仅演示，生产务必修改）
DEMO_USER_1_PASSWORD=Demo1234!
DEMO_USER_2_PASSWORD=Demo1234!

# ---------- 演示模式 ----------
# 强制开启本地演示模式（忽略 LLM_API_KEY）
FORCE_DEMO_MODE=false
# 演示数据中模拟交易的标识
SIMULATION_TAG=模拟交易
